# btc-trust configuration. Copy to .env and fill in. NEVER commit .env.
# SAFETY: regtest by default. Mainnet is refused unless ALLOW_MAINNET=true.
BITCOIN_NETWORK=regtest          # regtest | signet | testnet | testnet4 | main
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=18443           # regtest 18443, signet 38332, testnet 18332, main 8332
BITCOIN_RPC_USER=btctrust
BITCOIN_RPC_PASSWORD=change-me
BITCOIN_RPC_TIMEOUT_MS=10000
ALLOW_MAINNET=false

# API server
API_HOST=127.0.0.1               # use 0.0.0.0 inside a myNode/Docker container
API_PORT=4000
