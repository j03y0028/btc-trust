# btc-trust configuration. Copy to .env and fill in. NEVER commit .env.
# SAFETY: regtest by default. Mainnet is refused unless ALLOW_MAINNET=true.
BITCOIN_NETWORK=regtest          # regtest | signet | testnet | testnet4 | main
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=18443           # regtest 18443, signet 38332, testnet 18332, main 8332
BITCOIN_RPC_USER=btctrust
BITCOIN_RPC_PASSWORD=change-me
BITCOIN_RPC_TIMEOUT_MS=10000
ALLOW_MAINNET=false

# API server
API_HOST=127.0.0.1               # use 0.0.0.0 inside a myNode/Docker container
API_PORT=4000

# Hardware wallets (HWI, https://github.com/bitcoin-core/HWI)
HWI_MODE=auto                    # auto (use HWI_PATH if present) | cli | mock | off
HWI_PATH=/workspace/hwi/hwi
HWI_EMULATORS=true               # enumerate Trezor emulator / Speculos / Coldcard sim (forced false on mainnet unless set)
HWI_TIMEOUT_MS=120000            # time allowed for on-device confirmation

# Trust vault
VAULT_IDLE_MS=300000             # auto-lock after this much inactivity
VAULT_SCRYPT_N=131072            # scrypt cost (2^17); tests use 2^14 for speed

# Timeline (Stage 6): read-only mainnet observation. No wallet RPC is ever sent to this node.
MAINNET_SNAPSHOTS=true           # backend checks hourly and records one tip snapshot per local day
# MAINNET_RPC_HOST=mynode.local  # when set, prefer your own node's getblockchaininfo over public APIs (cross-checked)
# MAINNET_RPC_PORT=8332
# MAINNET_RPC_USER=
# MAINNET_RPC_PASSWORD=
# SNAPSHOT_TZ=America/Phoenix    # day boundary for the daily log (default: system timezone)
