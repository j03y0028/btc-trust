# docker compose --env-file btctrust.env up -d      (install-mynode.sh writes the myNode equivalent itself)
MAINNET_RPC_HOST=host.docker.internal
MAINNET_RPC_PORT=8332
MAINNET_RPC_USER=btctrust
MAINNET_RPC_PASSWORD=change-me-long-random
TESTNODE_RPC_PASSWORD=change-me-too
WALLET_CHAIN=regtest
WALLET_FEATURES=on
API_ALLOWED_HOSTS=mynode.local,mynode
SNAPSHOT_TZ=America/Phoenix
BTCTRUST_DATA=./data-docker
